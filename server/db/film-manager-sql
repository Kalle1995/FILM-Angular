CREATE TABLE IF NOT EXISTS movies (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    image TEXT, 
    year TEXT,
    type TEXT CHECK(type IN ('Action', 'Drama', 'Sci-Fi')),
    description TEXT,
    rating INTEGER CHECK(rating BETWEEN 1 AND 5)
);

